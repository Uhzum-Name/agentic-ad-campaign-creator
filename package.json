{
  "name": "agentic-ad-campaign-creator",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:services": "bash scripts/dev-services.sh",
    "db:generate": "pnpm --filter @adengine/db generate",
    "db:migrate": "pnpm --filter @adengine/db migrate",
    "dev:api": "pnpm --filter @adengine/api dev",
    "dev:worker": "pnpm --filter @adengine/worker dev",
    "dev:web": "pnpm --filter @adengine/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@adengine/core": "workspace:*",
    "@adengine/db": "workspace:*",
    "@adengine/engine": "workspace:*",
    "@adengine/figma": "workspace:*",
    "@adengine/storage": "workspace:*",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.0",
    "vitest": "^5.1.0"
  }
}
