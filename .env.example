# Copy to .env. All processes (api, worker, migrations, tests) read these.
DATABASE_URL=postgres://adengine:adengine@localhost:5432/adengine
TEST_DATABASE_URL=postgres://adengine:adengine@localhost:5432/adengine_test

# API server
API_PORT=4000
# When set, every /v1 request must send "Authorization: Bearer <API_KEY>".
# Leave empty for local development without auth.
API_KEY=

# Asset storage. "postgres" (default) keeps objects in the database so every
# process shares them; "local" writes under STORAGE_LOCAL_DIR.
STORAGE_DRIVER=postgres
STORAGE_LOCAL_DIR=.data/storage

# Web app: where the Next.js server proxies /api/* to.
# Leave unset to serve the API from inside the web app. Set it to proxy /api to a separate API server.
# API_URL=http://localhost:4000

# Figma personal access token (file_content:read). Used by design ingestion (milestone 3).
FIGMA_TOKEN=
